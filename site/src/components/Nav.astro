---
const links = [
  { href: "/#overview", label: "Overview" },
  { href: "/#features", label: "Features" },
  { href: "/#algorithms", label: "Algorithms" },
  { href: "/#api", label: "API" },
  { href: "/#citation", label: "Cite" },
];
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent"
 
>
  <div class="container-x flex h-16 items-center justify-between">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="grid h-8 w-8 place-items-center rounded-lg surface">
        <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
          <defs>
            <linearGradient id="nav-d" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#B8C5FF" />
              <stop offset="100%" stop-color="#6C82FF" />
            </linearGradient>
          </defs>
          <path
            d="M5 4 L5 20 M5 4 L13 4 C18 4 18 12 13 12 L5 12"
            fill="none"
            stroke="url(#nav-d)"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="18" cy="18" r="1.5" fill="#B8C5FF"></circle>
        </svg>
      </span>
      <span class="font-display text-[15px] font-semibold tracking-tight text-ink-50">driftflow</span>
      <span class="pill ml-2 hidden sm:inline-flex">
        <span class="pill-dot"></span>
        v1.0
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-full px-3 py-1.5 text-[13px] text-ink-200 transition hover:bg-white/5 hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/sachncs/driftflow"
        target="_blank"
        rel="noreferrer"
        class="btn btn-ghost hidden sm:inline-flex"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-.92c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.5-1.08-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.74-3.65 3.94.29.25.54.74.54 1.49v2.21c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        GitHub
      </a>
      <a href="/#install" class="btn btn-primary">
        Install
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</header>