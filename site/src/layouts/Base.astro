---
import "~/styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "driftflow — typed adaptive SDE sampling for graph diffusion",
  description = "A validated, polymorphic Python sampler for graph-diffusion SDEs.",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://sachncs.github.io/driftflow");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={`${base}/og-image.svg`} />
  </head>
  <body>
    <slot />
  </body>
</html>
