---
import Base from "~/layouts/Base.astro";
import Nav from "~/components/Nav.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const quickStart = `from driftflow import (
    CommonConfig, DvsAdaptiveController, DVSSampler,
    GraphState, GruMApproximation, LinearSchedule,
    get_dataset_config,
)

state = GraphState.from_lists(
    [[0.1, 0.2], [0.3, 0.4]],
    [[0.0, 0.1], [0.1, 0.0]],
)
dataset = get_dataset_config("GruM", "QM9")
sampler = DVSSampler(
    drift_model=GruMApproximation(2, 2, seed=42),
    noise_schedule=LinearSchedule(0.01, 0.5),
    controller=DvsAdaptiveController(
        CommonConfig(), dataset, dataset.gamma_euler or 0.0
    ),
)
result = sampler.sample(state, seed=42)`;

const tabs = [
  {
    id: "workflow",
    label: "Workflow",
    code: `state → DriftModel → DVS controller → Solver\n\nresult.state\nresult.diagnostics`,
  },
  {
    id: "contracts",
    label: "Contracts",
    code: `class DriftModel(ABC):\n    def evaluate(state, time) -> DriftState: ...\n\nclass Solver(ABC):\n    def step(...) -> GraphState: ...`,
  },
  {
    id: "safety",
    label: "Safety",
    code: `GraphState(...)            # shape + finite checks\nLinearSchedule(...)        # scale + time checks\nDVSSampler.sample(...)      # step-limit checks`,
  },
];
---

<Base>
  <div class="ambient ambient-one" aria-hidden="true"></div>
  <div class="ambient ambient-two" aria-hidden="true"></div>
  <Nav />
  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> v2.0 · typed research infrastructure</p>
        <h1>Spend compute where the trajectory bends.</h1>
        <p class="hero-lede">driftflow is a validated Python sampler for graph-diffusion SDEs. Drift Variation Score adapts the timestep to local change while your model and solver stay replaceable.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${base}/#api`}>Start with the API <span aria-hidden="true">↗</span></a>
          <a class="button button-ghost" href={`${base}/docs/`}>Read the docs <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-notes"><span>Python 3.10–3.14</span><span>stdlib runtime</span><span>MIT licensed</span></div>
      </div>
      <div class="glass-panel hero-panel" aria-label="Typed sampling pipeline">
        <div class="panel-topline"><span class="panel-label">One explicit pipeline</span><span class="live-pill"><i></i> validated</span></div>
        <div class="pipeline">
          <div class="pipeline-step"><span class="step-index">01</span><span><b>GraphState</b><small>immutable input</small></span><strong>→</strong></div>
          <div class="pipeline-step"><span class="step-index">02</span><span><b>DriftModel</b><small>evaluate(state, t)</small></span><strong>→</strong></div>
          <div class="pipeline-step pipeline-focus"><span class="step-index">03</span><span><b>DVS controller</b><small>choose a bounded step</small></span><strong>→</strong></div>
          <div class="pipeline-step"><span class="step-index">04</span><span><b>Solver</b><small>Euler-Maruyama or Heun</small></span><strong>✓</strong></div>
        </div>
        <div class="panel-foot"><span class="signal-bars"><i></i><i></i><i></i><i></i><i></i></span> boundaries checked before integration</div>
      </div>
    </section>

    <section id="workflow" class="section shell">
      <div class="section-heading"><p class="eyebrow">Why adaptive?</p><h2>One loop. Better decisions.</h2><p>Flat regions do not need the same resolution as sharp turns. DVS makes that decision explicit without coupling your model to the orchestration loop.</p></div>
      <div class="glass-grid three-up">
        <article class="glass-panel feature-card"><span class="number">01 / MEASURE</span><h3>Read local change</h3><p>Compare consecutive drifts and normalize the variation by the current noise scale.</p></article>
        <article class="glass-panel feature-card"><span class="number">02 / CONTROL</span><h3>Bound the response</h3><p>EMA smoothing and power-law scaling choose one synchronized timestep for both modalities.</p></article>
        <article class="glass-panel feature-card"><span class="number">03 / INTEGRATE</span><h3>Swap the machinery</h3><p>Pass the typed state through a polymorphic solver and keep structured diagnostics.</p></article>
      </div>
    </section>

    <section id="api" class="section shell">
      <div class="section-heading section-heading-inline"><div><p class="eyebrow">The v2 API</p><h2>Small surface. Strong contracts.</h2></div><p>Replace a model, schedule, controller, solver, or decoder without rewriting the sampler.</p></div>
      <div class="glass-panel code-card">
        <div class="code-toolbar"><div class="tab-list" role="tablist" aria-label="API examples">
          {tabs.map((tab, index) => <button role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={index === 0 ? "true" : "false"} data-tab={tab.id}>{tab.label}</button>)}
        </div><button class="copy-button" type="button" data-copy-target="api-sample">Copy</button></div>
        {tabs.map((tab, index) => <pre id={`panel-${tab.id}`} role="tabpanel" aria-labelledby={`tab-${tab.id}`} data-panel={tab.id} hidden={index !== 0}><code>{tab.code}</code></pre>)}
        <pre id="api-sample" class="sample-hidden" aria-hidden="true"><code>{quickStart}</code></pre>
      </div>
    </section>

    <section id="trust" class="section shell trust-section">
      <div class="section-heading"><p class="eyebrow">Reliability by design</p><h2>Clear failures are part of the API.</h2><p>Infrastructure is easier to trust when its boundaries are visible.</p></div>
      <div class="glass-panel trust-list"><div><b>Immutable states</b><span>GraphState and DriftState freeze nested matrices and reject non-finite values.</span></div><div><b>Explicit errors</b><span>Configuration, shape, schedule, numerical, solver, and sampling-limit failures.</span></div><div><b>Honest scope</b><span>Approximation models are labeled educational stand-ins, not trained denoisers.</span></div><div><b>Per-call seeds</b><span>Reproducible trajectories without hidden global random state.</span></div></div>
    </section>

    <section id="install" class="section shell install-section">
      <div><p class="eyebrow">Install</p><h2>Start from a state you can inspect.</h2><p>Install the package, read the migration guide, then wire in your production denoiser.</p></div>
      <div class="glass-panel install-card"><div class="install-command"><span class="prompt">$</span><code>python -m pip install driftflow</code></div><button class="copy-button" type="button" data-copy-target="install-command">Copy</button><pre id="install-command" class="sample-hidden" aria-hidden="true"><code>python -m pip install driftflow</code></pre><a class="button button-primary" href={`${base}/docs/`}>Open documentation <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <footer class="footer shell"><span>driftflow · v2.0.0 · MIT licensed</span><span><a href="https://github.com/sachncs/driftflow" target="_blank" rel="noreferrer">GitHub</a><a href="https://arxiv.org/abs/2605.00250" target="_blank" rel="noreferrer">Paper</a></span></footer>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
    const source = document.querySelector<HTMLElement>("#api-sample");
    const copy = async (button: HTMLButtonElement, target: HTMLElement) => {
      const original = button.textContent;
      try { await navigator.clipboard.writeText(target.innerText.trim()); button.textContent = "Copied"; }
      catch { button.textContent = "Copy failed"; }
      window.setTimeout(() => { button.textContent = original; }, 1400);
    };
    tabs.forEach((tab) => tab.addEventListener("click", () => {
      const id = tab.dataset.tab;
      tabs.forEach((item) => item.setAttribute("aria-selected", String(item === tab)));
      panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
      const active = panels.find((panel) => panel.dataset.panel === id);
      if (source && active) source.innerText = active.innerText;
    }));
    document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((button) => button.addEventListener("click", () => {
      const target = document.querySelector<HTMLElement>(`#${button.dataset.copyTarget}`);
      if (target) copy(button, target);
    }));
  </script>
</Base>
