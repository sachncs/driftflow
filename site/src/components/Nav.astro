---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="site-header" data-header>
  <div class="shell nav-shell">
    <a class="brand" href={`${base}/`} aria-label="driftflow home">
      <span class="brand-mark" aria-hidden="true">d</span>
      <span>driftflow</span>
      <span class="version">v2</span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-button>
      <span class="sr-only">Toggle navigation</span>
      Menu
    </button>
    <nav id="site-navigation" class="site-nav" aria-label="Primary navigation" data-navigation>
      <a href={`${base}/#workflow`}>Workflow</a>
      <a href={`${base}/#api`}>API</a>
      <a href={`${base}/#trust`}>Reliability</a>
      <a href={`${base}/docs/`}>Docs</a>
      <a href="https://github.com/sachncs/driftflow" target="_blank" rel="noreferrer">GitHub</a>
      <a class="button button-small" href={`${base}/docs/`}>Read the docs <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const navigation = document.querySelector<HTMLElement>("[data-navigation]");
  if (button && navigation) {
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!expanded));
      navigation.toggleAttribute("data-open", !expanded);
    });
  }
</script>
