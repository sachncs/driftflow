---
---

<section class="relative py-24 sm:py-32">
  <div class="container-x">
    <div
      class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-ink-800/60 to-ink-900/80 px-8 py-16 text-center sm:px-14 sm:py-20"
     
    >
      <div class="absolute inset-0 -z-10 dot-grid opacity-50"></div>
      <div class="absolute inset-x-0 -top-32 -z-10 h-72 bg-grid-fade"></div>

      <p class="eyebrow justify-center">
        <span class="h-px w-6 bg-aurora-300"></span>
        Get started
        <span class="h-px w-6 bg-aurora-300"></span>
      </p>
      <h2 class="display mx-auto mt-5 max-w-3xl text-display-lg text-ink-50">
        Wrap a drift. <span class="aurora-text">Sample smarter.</span>
      </h2>
      <p class="lead mx-auto mt-5 max-w-xl">
        pip-install driftflow, point it at any graph-diffusion denoiser, and
        let the Drift Variation Score take it from there.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="#install" class="btn btn-primary">
          <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M8 1v9M4 7l4 3 4-3M2 14h12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          pip install driftflow
        </a>
        <a
          href="https://github.com/sachncs/driftflow"
          target="_blank"
          rel="noreferrer"
          class="btn btn-ghost"
        >
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>