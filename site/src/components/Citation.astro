---
const bib = `@article{driftflow2026,
  title  = {Information-Geometric Adaptive Sampling for Graph Diffusion},
  journal = {arXiv preprint arXiv:2605.00250},
  year   = {2026}
}`;
---

<section id="citation" class="relative py-24 sm:py-32">
  <div class="container-x">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">
          <span class="h-px w-6 bg-aurora-300"></span>
          Cite
        </p>
        <h2 class="display mt-5 text-display-lg text-ink-50">
          A faithful reproduction of an arXiv paper.
        </h2>
        <p class="lead mt-6">
          If you use driftflow in academic work, please cite the original paper.
          The package is a pure-Python reproduction of Algorithms 1–3 from the
          reference below.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="https://arxiv.org/abs/2605.00250"
            target="_blank"
            rel="noreferrer"
            class="btn btn-ghost"
          >
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M3 3h10v10H3z" />
              <path d="M3 7h10M7 3v10" />
            </svg>
            arXiv:2605.00250
          </a>
          <a
            href="https://github.com/sachncs/driftflow/blob/main/CHANGELOG.md"
            target="_blank"
            rel="noreferrer"
            class="btn btn-ghost"
          >
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M2 4h12M2 8h12M2 12h12" />
            </svg>
            CHANGELOG
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="code-shell">
          <div class="flex items-center justify-between border-b border-white/5 bg-white/[0.02] px-4 py-2 text-xs text-ink-300">
            <span>BibTeX</span>
            <button class="btn btn-ghost !py-1 !text-xs" data-copy="#cite-code">
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="4" y="4" width="9" height="9" rx="1.5" />
                <path d="M2 11V3a1 1 0 0 1 1-1h8" />
              </svg>
              <span data-label>Copy</span>
            </button>
          </div>
          <pre><code id="cite-code">{bib}</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>